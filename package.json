{
  "name": "bvalue-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run --project core test/live.test.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply sgc-swarm --local",
    "db:migrate:remote": "wrangler d1 migrations apply sgc-swarm --remote",
    "cli": "tsx core/cli.ts",
    "logs": "tsx scripts/logs.ts"
  },
  "dependencies": {
    "@bvalue/seismo": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "hono": "^4.13.8",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.10.0",
    "ogl": "^1.0.11",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.10.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.55.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@shadcn/lint": "^0.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "msw": "^2.15.0",
    "oxfmt": "^0.69.0",
    "oxlint": "^1.84.0",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.134.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
