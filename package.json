{
  "name": "sgc-swarm",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run --project core test/live.test.ts",
    "typecheck": "tsc -b",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply sgc-swarm --local",
    "db:migrate:remote": "wrangler d1 migrations apply sgc-swarm --remote",
    "cli": "tsx core/cli.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.55.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.134.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "hono": "^4.13.8",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.10.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  }
}
