{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint", { "name": "react-hooks-js", "specifier": "eslint-plugin-react-hooks" }],
  "ignorePatterns": [".agents/", ".claude/"],
  "settings": {
    "shadcn": {
      "ignoreImports": ["^@/components/ui/collapsible$"],
      "note": "Design-system rules and approved exceptions: docs/frontend.md, \"Design-system lint\"."
    }
  },
  "rules": {
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^(Alert|CardContent|FieldGroup|Tabs|TabsContent)$",
            "allow": ["layout", "spacing"]
          }
        ]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",
    "react-hooks-js/rules-of-hooks": "error",
    "react-hooks-js/exhaustive-deps": "error",
    "react-hooks-js/refs": "error",
    "react-hooks-js/immutability": "error",
    "react-hooks-js/purity": "error",
    "react-hooks-js/set-state-in-render": "error",
    "react-hooks-js/set-state-in-effect": "error",
    "react-hooks-js/static-components": "error",
    "react-hooks-js/use-memo": "error",
    "react-hooks-js/preserve-manual-memoization": "error",
    "react-hooks-js/incompatible-library": "error",
    "react-hooks-js/globals": "error",
    "react-hooks-js/error-boundaries": "error",
    "react-hooks-js/unsupported-syntax": "error",
    "react-hooks-js/component-hook-factories": "error"
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/require-static-classes": "off"
      }
    }
  ]
}
