{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "ignorePatterns": [
    ".agents/",
    ".claude/",
    "test/fixtures/",
    "worker-configuration.d.ts",
    "pnpm-lock.yaml",
    "**/*.md"
  ],
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "options": { "semi": false, "printWidth": 80, "trailingComma": "es5" }
    }
  ]
}
