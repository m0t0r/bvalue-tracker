{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "choco",
  // Pinned so a deploy can never land in another account.
  "account_id": "007ce3d670b57672f62e4ffd3869dfc5",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Per-IP ceiling on /api/*. The same-origin check keeps other sites' pages out;
  // this keeps any single caller from turning the API into a D1 bill.
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sgc-swarm",
      "database_id": "42d8a465-e932-47c1-92fd-ba0c79555216",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Every 5 min: the trailing 1 day, insert/update only. Every 15th of those minutes it
    // widens to the trailing 3 days and does removals instead. Both lanes are one pattern
    // on purpose — two would fire together and one would lose the claim.
    // Hourly at :07: re-check one older 7-day chunk for revisions. The minute must not be
    // a multiple of 5, or it would collide with the tick above. The page copy in
    // src/lib/i18n.tsx says "5 minutos"; change them together.
    "crons": ["*/5 * * * *", "7 * * * *"]
  },
  "observability": { "enabled": true }
}
