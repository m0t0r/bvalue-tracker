{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "choco",
  // Pinned so a deploy can never land in another account.
  "account_id": "007ce3d670b57672f62e4ffd3869dfc5",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  // There is one page and no client-side router, so the single-page-application fallback only
  // meant that every wrong path — /robots.txt, /favicon.ico, a crawler's guess — answered 200
  // with the whole app. "none" sends an asset miss to the Worker, which answers a plain 404.
  "assets": {
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  // Per-IP ceiling on /api/*. The same-origin check keeps other sites' pages out;
  // this keeps any single caller from turning the API into a D1 bill.
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sgc-swarm",
      "database_id": "42d8a465-e932-47c1-92fd-ba0c79555216",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Every 5 min: the trailing 1 day, insert/update only. Every 15th of those minutes it
    // widens to the trailing 3 days and does removals; on the hour it also re-checks one
    // older 7-day chunk for revisions. Deliberately ONE pattern: any second pattern lands
    // within 120 s of this one, inside the 150 s in-flight window, and the two would keep
    // stealing each other's claim. See scheduled() in worker/index.ts.
    // The page copy in src/lib/i18n.tsx says "5 minutos"; change them together.
    "crons": ["*/5 * * * *"]
  },
  "observability": { "enabled": true }
}
