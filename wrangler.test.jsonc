{
  // Test-only config: same Worker and D1 binding, without static assets or cron.
  "name": "sgc-swarm-test",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  // Per-IP ceiling on /api/*. The same-origin check keeps other sites' pages out;
  // this keeps any single caller from turning the API into a D1 bill.
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "sgc-swarm", "database_id": "test", "migrations_dir": "migrations" }]
}
