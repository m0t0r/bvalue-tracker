# Served by Cloudflare's static-asset layer, which handles everything except /api/*
# (run_worker_first). The API sets its own cache-control per route.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  # The site is HTTPS-only: the zone's "Always Use HTTPS" sends http:// to https:// before the
  # Worker sees it. Two years, every subdomain, and `preload`, which is what hstspreload.org asks
  # for. bvalue.site is a registrable domain, so unlike the old workers.dev name it can be put on
  # the browser preload list; whether it is, is in docs/security.md. Do not drop includeSubDomains
  # or shorten max-age while it is listed or pending: that is how a listing is undone.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # The page asks for no device permissions at all: no geolocation (the map has no
  # locate control), no camera, microphone or clipboard. Deny the lot, so a future
  # dependency cannot quietly start using one. Unknown feature names are ignored by
  # browsers, so this list is safe to keep ahead of what any one browser implements.
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  # We open no cross-origin windows and nothing should embed our assets. COEP is
  # deliberately absent: tiles.openfreemap.org and tiles.mapterhorn.com send no CORP
  # header, so require-corp would blank the map.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # Verified against the running page on 2026-09-24: basemap tiles, sprites, glyphs, the
  # relief shading, the event dots and the chart axis labels all render with this policy
  # on. It is narrow, so re-check the map and charts if any of these change:
  #   blob:            MapLibre GL 6 runs its worker from a blob URL
  #   'unsafe-inline'  each page carries its header's CSS in a <style> (issues #97, #120), and
  #                    the static header has style attributes (Radix's outline:none on a tab
  #                    panel). Styles React sets at runtime go through the CSSOM and need nothing.
  #   tiles.openfreemap.org  basemap style, sprites, glyphs and vector tiles
  #   tiles.mapterhorn.com   the map's relief (elevation tiles); connect-src only, since
  #                          MapLibre fetches raster-dem tiles and never loads them as <img>
  #   static.cloudflareinsights.com  Cloudflare Web Analytics' beacon, which the edge adds to each
  #                          page on bvalue.site (automatic setup). Host only: the injected URL has
  #                          a version after /beacon.min.js, which a path source would refuse. It
  #                          reports to /cdn-cgi/rum on the site itself, so connect-src needs nothing.
  Content-Security-Policy: default-src 'self'; script-src 'self' blob: https://static.cloudflareinsights.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' https://tiles.openfreemap.org https://tiles.mapterhorn.com; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'

# Everything Vite emits under /assets/ has a content hash in its name, so a changed file is a
# new URL and this can be cached for good. Without a rule the asset layer answers
# `max-age=0, must-revalidate`, which makes every repeat visit revalidate the bundle, the
# stylesheet and the font. index.html is deliberately left on the default: it is the file that
# points at the hashed ones.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Each page is its own entry, so a link between them is a full navigation. The rules let Chrome load the
# page a link points to before the reader lets go of it (issue #107; docs/performance.md). A header
# rather than a <script type="speculationrules">, which the CSP's script-src would have to allow. The
# file must be served with this exact type, or Chrome ignores it. Safari and Firefox ignore both. It has
# no hash in its name, so it is not under /assets/*; an hour's cache spares every page load a
# revalidation, and an hour of the old rules after a deploy costs nothing.
/
  Speculation-Rules: "/speculation-rules.json"
/choco
  Speculation-Rules: "/speculation-rules.json"
/insights
  Speculation-Rules: "/speculation-rules.json"
/speculation-rules.json
  Content-Type: application/speculationrules+json
  Cache-Control: public, max-age=3600
